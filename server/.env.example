# ==============================================================================
# JanSahay AI Server - Environment Configuration Template
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# Database Connection (PostgreSQL with Prisma / Drizzle)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jansahay_db?schema=public

# Security & Authentication
# JWT Secret key (at least 32 characters / 256 bits for HMAC-SHA256)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace_with_another_secure_refresh_secret_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# CORS Whitelist (comma-separated allowed origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Express Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# AI Provider Configuration (Deterministic Engine / Gemini RAG)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Observability & Logging (trace, debug, info, warn, error)
LOG_LEVEL=info
