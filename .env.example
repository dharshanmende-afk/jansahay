# ==============================================================================
# JanSahay AI Monorepo / Docker Compose - Environment Template
# ==============================================================================

# Node Environment
NODE_ENV=development

# Server Port & Endpoint
SERVER_PORT=5000
CLIENT_PORT=5173

# PostgreSQL Database (Docker & Local)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_here
POSTGRES_DB=jansahay_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_password_here@postgres:5432/jansahay_db?schema=public

# Security & Authentication Secrets
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace_with_another_secure_refresh_secret_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# CORS Whitelist (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Client Configuration
VITE_API_URL=http://localhost:5000/api

# AI Service (Google Gemini)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
