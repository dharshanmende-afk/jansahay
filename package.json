{
  "name": "jansahay-ai",
  "version": "2.0.0",
  "description": "JanSahay AI - Intelligent Government Scheme Discovery & Smart Document Guidance for Indian Citizens",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "server": "cd server && npm start",
    "server:dev": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "client:build": "cd client && npm run build",
    "build": "cd client && npm run build",
    "seed": "cd server && npm run seed",
    "migrate": "cd server && npm run migrate",
    "test": "cd server && npm test",
    "test:coverage": "cd server && npm run test:coverage",
    "lint": "cd server && npm run lint",
    "validate:schemes": "cd server && npm run validate:schemes",
    "eval:rag": "cd server && npm run eval:rag",
    "generate:pdf": "node scripts/generateProjectReportPdf.js",
    "start": "cd server && npm start"
  },
  "keywords": [
    "govtech",
    "react",
    "nodejs",
    "express",
    "postgresql",
    "welfare-schemes",
    "india",
    "rts-act",
    "rag",
    "gemini"
  ],
  "author": "Dharshan Mende (https://github.com/dharshanmende-afk)",
  "homepage": "https://github.com/dharshanmende-afk/jansahay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dharshanmende-afk/jansahay.git"
  },
  "license": "MIT"
}
